<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="A moment to pray" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/widget_dove" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add a prayer in Prayer Wall to see it here." android:textColor="@color/widget_ink" android:paddingVertical="12dp" />
    <TextView android:id="@+id/prayer_one" style="@style/PrayerWidgetRow" />
    <TextView android:id="@+id/prayer_two" style="@style/PrayerWidgetRow" />
    <TextView android:id="@+id/prayer_three" style="@style/PrayerWidgetRow" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Prayer Wall" android:textSize="12sp" android:textColor="@color/widget_ink" />
</LinearLayout>
