  "narrative": {
    "northStar": "The Living Prayer Wall",
    "overview": "A personal, expressive prayer wall pairs soft graphic biblical artwork with tactile writing materials. Neutral and off-white controls give colorful content room to breathe; lilac, blue, butter, mint and peach give topics and communities visual character. Confident headings, clear author rows and readable prayer text carry the experience.\n\nThe owner-approved Option A dove is binding: an ivory silhouette, lavender teardrop wing, plum eyes, peach beak and olive sprig. Matching original stickers share broad 2D shapes and light shading. Preserve the incumbent Flutter app and local data; its visual system serves an honest local experience.",
    "keyCharacteristics": [
      "Expressive materials with live, selectable prayer text.",
      "Soft graphic biblical art with a single approved dove identity.",
      "Monochrome filled controls, colorful content and calm readable spacing.",
      "Short state feedback with reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Colorful Content Rule",
        "body": "Keep essential actions monochrome; preserve topical, community and post-material color. Bible-inspired page tabs use the butter selected fill as an established selection exception.",
        "section": "colors"
      },
      {
        "name": "The Readable Material Rule",
        "body": "Default materials follow theme-specific fill and ink. An explicit curated pastel overrides material fill and uses dark charcoal ink in both themes; decoration must yield to readable live text.",
        "section": "colors"
      },
      {
        "name": "The Material Depth Rule",
        "body": "Keep depth local to its role: subtle action lift or sticky-paper tactility, never a hard offset shadow applied to every card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the owner-approved Option A dove identity and matching soft graphic artwork.",
      "**Do** keep readable live text central in every post material and theme.",
      "**Do** use filled surfaces and functional focus feedback.",
      "**Do** reduce decoration before clipping or shrinking large text.",
      "**Do** use brief state feedback and respect reduced motion."
    ],
    "donts": [
      "**Don't** add decorative borders to cards or buttons.",
      "**Don't** replace the approved identity with toy renders or historical candidate mascots.",
      "**Don't** imply that the Public audience selection uploads content or that local community preferences establish real membership.",
      "**Don't** use continuous icon loops or pretend a static PNG is an articulated character."
    ]
  }
